# Copy to .env and fill what you need.
# PayPal sandbox is enough to try the board.
PAYPAL_LIVE=0
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The full app can draft listings/negotiation text with an OpenAI-compatible API.
# Leave empty to use deterministic fallbacks.
AI_PROVIDER=openai
AI_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=

NETWORK_ID=bitsettled-local
INSTANCE_NAME=bitsettled
INSTANCE_TAGLINE=merchant offer agents settle
NETWORK_SEEDS=
PLATFORM_FEE_BPS=50
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_SITE_URL=http://localhost:8080
SEED_DEMO=1
STATE_PATH=/data/settled-state.json
