# Settled — environment template
#
# Copy to .env and fill in what you have. Everything here is optional:
# with no keys at all the app runs in deterministic SIM mode and the demo works.
#
# IMPORTANT: this project has zero dependencies and does NOT auto-load .env.
# Either export these in your shell before `node server.js`, or load the file:
#   set -a; . ./.env; set +a; node server.js
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# AI — negotiation + claim explanation (OpenAI-compatible chat-completions API)
# ---------------------------------------------------------------------------
# openai = call the model below; none = force the deterministic fallback.
AI_PROVIDER=openai
# Your API key. Leave blank to run without a model (fallback: ai.used=false).
AI_API_KEY=
# Any model served by an OpenAI-compatible endpoint (AI_BASE_URL).
AI_MODEL=gpt-4o-mini
# Point at OpenAI or any compatible gateway. Ollama Cloud: https://ollama.com/v1 + AI_MODEL=gpt-oss:20b
# (or local: http://127.0.0.1:11434/v1 + a pulled model).
AI_BASE_URL=https://api.openai.com/v1
# Abort an LLM call after this many ms, then fall back deterministically.
AI_TIMEOUT_MS=30000
# 8000 is fine for hosted APIs; local models (Ollama) may need 20000-30000 on first load.

# Public origin used in PayPal return URLs (recommended for Render/tunnels).
# Example: https://your-demo.onrender.com
PUBLIC_BASE_URL=

# Platform take rate on negotiated GMV (basis points; 50 = 0.50%).
# This is recorded on every order. Real collection via PayPal platform_fees
# requires a PayPal partner/marketplace account and PAYPAL_PLATFORM_FEE_PAYEE.
PLATFORM_FEE_BPS=50
PAYPAL_PLATFORM_FEES=0
PAYPAL_PLATFORM_FEE_PAYEE=

# ---------------------------------------------------------------------------
# PayPal — live sandbox rail (Orders v2 create/capture, Payments v2 refund)
# ---------------------------------------------------------------------------
# 1 = use the real PayPal API (with the credentials below); 0 or unset = SIM.
# SIM returns SIM-… ids, moves no money, and is the safe fallback for judges.
PAYPAL_LIVE=1
# developer.paypal.com → Apps & Credentials → Sandbox → your app's client id.
PAYPAL_CLIENT_ID=
# Same app's secret. Keep it out of git, screenshots and the video.
PAYPAL_CLIENT_SECRET=
# sandbox for the hackathon; live only for real money.
PAYPAL_ENV=sandbox

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------
# PORT=4173
# HOST=127.0.0.1
